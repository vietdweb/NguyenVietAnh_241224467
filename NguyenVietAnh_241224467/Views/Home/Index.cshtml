@{
    ViewData["Title"] = "Home Page";
}
@model IEnumerable<NguyenVietAnh_241224467.Models.Sach>

<!-- Sách mới -->
<div class="section-head">
    <h3 id="tieu-de">NguyenVietAnh</h3>
    <a href="#">Xem tất cả &rsaquo;</a>
</div>
<div id="content" class="grid">
    @foreach(var item in Model)
    {
        <div class="book-card">
            <a href="#"><img src="images/@item.Anh" alt="" /></a>
            <h2>@item.TenSach</h2>
            <div class="book-foot"><span class="price">@item.Gia</span><button class="btn-buy">Thêm vào giỏ</button></div>
        </div>
    }

</div>
@section Scripts{
    <script>
        $(".menu li").click(function(){
            var id = $(this).attr("id");
            var tenTl = $(this).text();
            $(".menu li").removeClass("active");
            $(this).addClass("active");
            if(id){
                $.ajax({
                    url:"/Home/SachTheoLoai",
                    data:{matl:id},
                    success:function(response){
                        $("div#content").html(response);
                        $("#tieu-de").text(tenTl);
                    }
                });
            }
        });
    </script>
}